rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /experiments/social-decision-v1/submissions/{participantId} {
      // Research responses: participants can CREATE their own one-time response.
      // Only a Google-authenticated UID listed here may READ researcher exports.
      // The placeholder grants nobody access until the owner replaces and publishes it.
      function isResearcher() {
        return request.auth != null
          && request.auth.token.firebase.sign_in_provider == 'google.com'
          && request.auth.uid in ['4lw2iMco3uMSscJ2Earrdao5KeU2'];
      }

      allow get, list: if isResearcher();
      allow update, delete: if false;

      function expectedFields() {
        return [
          'participantId', 'experimentId', 'experimentVersion',
          'randomizationSeed', 'order', 'startedAtISO', 'completedAtISO',
          'trials', 'totalDurationMs', 'submittedAt'
        ];
      }

      // Preserve exactly the existing create-only participant permissions.
      allow create: if request.auth != null
        && request.auth.uid == participantId
        && request.auth.token.firebase.sign_in_provider == 'anonymous'
        && request.resource.data.keys().hasAll(expectedFields())
        && request.resource.data.keys().hasOnly(expectedFields())
        && request.resource.data.participantId == participantId
        && request.resource.data.experimentId == 'social-decision-v1'
        && request.resource.data.experimentVersion == '1.0.0'
        && request.resource.data.submittedAt == request.time
        && request.resource.data.randomizationSeed is int
        && request.resource.data.randomizationSeed >= 0
        && request.resource.data.randomizationSeed <= 4294967295
        && request.resource.data.startedAtISO is string
        && request.resource.data.completedAtISO is string
        && request.resource.data.startedAtISO.size() == 24
        && request.resource.data.completedAtISO.size() == 24
        && request.resource.data.order is list
        && request.resource.data.order.size() == 30
        && request.resource.data.order[0] is string
        && request.resource.data.trials is list
        && request.resource.data.trials.size() == 30
        && request.resource.data.trials[0] is map
        && request.resource.data.trials[29] is map
        && request.resource.data.totalDurationMs is int
        && request.resource.data.totalDurationMs >= 0;
    }

    // Compensation contact data live in a different collection from trial ratings.
    // The contact document holds no anonymous auth UID and no trial responses.
    match /experiments/social-decision-v1/compensation_contacts/{contactId} {
      function isResearcher() {
        return request.auth != null
          && request.auth.token.firebase.sign_in_provider == 'google.com'
          && request.auth.uid in ['4lw2iMco3uMSscJ2Earrdao5KeU2'];
      }

      allow get, list: if isResearcher();
      allow update, delete: if false;
      allow create: if request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'anonymous'
        && request.resource.data.keys().hasAll([
          'phone', 'consented', 'consentVersion', 'experimentId', 'submittedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'phone', 'consented', 'consentVersion', 'experimentId', 'submittedAt'
        ])
        && request.resource.data.phone is string
        && request.resource.data.phone.matches('^(010[0-9]{8}|01[16789][0-9]{7,8})$')
        && request.resource.data.consented == true
        && request.resource.data.consentVersion == 'reward-phone-v1'
        && request.resource.data.experimentId == 'social-decision-v1'
        && request.resource.data.submittedAt == request.time
        // Atomic batch requirement: a new complete submission from this UID must
        // exist in the same commit. Reusing an old submission is not accepted.
        && getAfter(/databases/$(database)/documents/experiments/social-decision-v1/submissions/$(request.auth.uid)).data.submittedAt == request.time;
    }
  }
}